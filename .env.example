# Gemini API key for server-side image detection
GEMINI_API_KEY=
# Configurable Gemini model name (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# SiliconFlow API key (硅基流动 API Key - 支持高并发/不限量/免费额度)
SILICONFLOW_API_KEY=
# Configurable SiliconFlow Vision Model (e.g. Qwen/Qwen2-VL-72B-Instruct, Qwen/Qwen2-VL-7B-Instruct)
SILICONFLOW_MODEL=Qwen/Qwen2-VL-72B-Instruct
