# Gemini API key for server-side image detection (Multiple keys separated by comma)
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Custom Gemini Proxy/Relay Base URL if needed
GEMINI_BASE_URL=
# Configurable Gemini model name (e.g. gemini-2.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# API Relay / One API / New API (支持微信/支付宝充值的小额第三方中转平台)
RELAY_API_KEY=
RELAY_BASE_URL=https://api.your-relay.com/v1
RELAY_MODEL=gemini-2.5-flash

# OpenAI / SiliconFlow Compatible API key
OPENAI_API_KEY=
OPENAI_BASE_URL=
SILICONFLOW_API_KEY=
