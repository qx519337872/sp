# Gemini API key for server-side image detection
# In Vercel, add GEMINI_API_KEY under Project Settings -> Environment Variables
GEMINI_API_KEY=

# Optional: Configurable Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Custom Gemini API Base URL if using Google Cloud / Vertex proxy
GEMINI_BASE_URL=

